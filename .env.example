# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
#
# The server validates this configuration when it starts (src/server/config/server-config.ts) and refuses to
# start if anything is missing or inconsistent, listing every problem. Nothing has a default: sandbox and
# production each set their own values (their own Paddle products, GitHub org and team, licence key and site).
# Everything below is required unless marked "production only" or "optional". The NEXT_PUBLIC_ values the browser
# uses (Supabase, Paddle, checkout) are compiled into the build, which checks them too (src/lib/public-config.ts):
# redeploy to change one.

# Site
## This environment's own origin, for links in emails and sign-in redirects (sign in on this address): e.g.
## http://localhost:3000. Only the server reads it, when it starts, despite its prefix.
NEXT_PUBLIC_SITE_URL=

# Supabase
## Private
SUPABASE_SERVICE_ROLE_KEY=
## Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paddle
## Private
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_ENV= # exactly `sandbox` or `production`; there is no default
## Public
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
## This environment's Tenantry Pro product id (Paddle → Catalog → Products, "pro_..."). A subscription to
## it entitles to Pro; any other product entitles to nothing. There is no default.
PADDLE_PRO_PRODUCT_ID=
## The Pro product's monthly and yearly price ids ("pri_..."), compiled into the client: redeploy to change.
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
## "true" opens the checkout; anything else (or unset) shows the offer without selling it. Redeploy to change.
NEXT_PUBLIC_CHECKOUT_ENABLED=

# Licensing
## P-256 PKCS#8 private key (PEM) used to sign Pro licence tokens. In production it must be the key whose public
## half is embedded in Tenantry.Pro; every other environment must use its own keypair (the server checks both).
LICENCE_SIGNING_PRIVATE_KEY=

# GitHub App (private package-feed provisioning)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_ORG= # no default: sandbox uses its own org with a test package
GITHUB_TEAM=

# Email (Resend) — production only (optional elsewhere: without RESEND_API_KEY, emails are logged, not sent)
RESEND_API_KEY=
# The no-reply sender, e.g. `Tenantry <noreply@tenantry.dev>`. Required wherever RESEND_API_KEY is set: no default.
EMAIL_FROM=
# Where customers' replies go (the sender is a no-reply address). Required in production.
EMAIL_REPLY_TO=
# Where operator alerts go (e.g. a licence that cannot be issued). Required in production; elsewhere alerts
# are only logged unless it is set.
ALERT_EMAIL=

# Reconcile cron — bearer secret for /api/reconcile. Vercel Cron auto-sends this as
# `Authorization: Bearer <CRON_SECRET>`; also required for manual POST triggers.
CRON_SECRET=

# Optional. Automated provisioning switch: `manual` or `auto`; any other value stops the server. Only `auto`
# lets the webhook, reconcile and account-linking paths grant GitHub access and issue licences. Unset or
# `manual`: purchases are recorded and access is provisioned by hand. Set `auto` only once the environment
# boundary has been verified.
PROVISIONING_MODE=
