# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
#
# The server validates this configuration when it starts (src/server/config/server-config.ts) and refuses to
# start if anything is missing or inconsistent, listing every problem. Nothing has a default: sandbox and
# production each set their own values (their own Paddle products, database, licence key, feed publish key and site).
# Everything below is required unless marked "production only" or "optional". The NEXT_PUBLIC_ values the browser
# uses (Supabase, Paddle, checkout) are compiled into the build, which checks them too (src/lib/public-config.ts):
# redeploy to change one.

# Site
## This environment's own origin, for links in emails and sign-in redirects (sign in on this address): e.g.
## http://localhost:3000. Only the server reads it, when it starts, despite its prefix.
NEXT_PUBLIC_SITE_URL=

# Supabase
## Private
SUPABASE_SERVICE_ROLE_KEY=
## Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local Supabase only (optional): a GitHub OAuth app, for signing in with GitHub on the local stack; its callback URL is http://127.0.0.1:54321/auth/v1/callback. The Supabase CLI reads them from `.env.local`
# for supabase/config.toml (the site does not); restart the stack (`supabase stop`, then `supabase start`) after a
# change.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Paddle
## Private
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_ENV= # exactly `sandbox` or `production`; there is no default
## Public
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
## This environment's Tenantry Pro product id (Paddle → Catalog → Products, "pro_..."). A subscription to
## it entitles to Pro; any other product entitles to nothing. There is no default.
PADDLE_PRO_PRODUCT_ID=
## The Pro product's monthly and yearly price ids ("pri_..."), compiled into the client: redeploy to change. Each
## one the site is configured with is kept in offered_prices, so payments at an earlier price still count.
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
## "true" opens the checkout; anything else (or unset) shows the offer without selling it. Redeploy to change.
NEXT_PUBLIC_CHECKOUT_ENABLED=

# Licensing
## P-256 PKCS#8 private key (PEM) used to sign Pro licence tokens. In production it must be the key whose public
## half is embedded in Tenantry.Pro; every other environment must use its own keypair (the server checks both).
LICENCE_SIGNING_PRIVATE_KEY=

# Package feed (/feed/v3)
## The hex SHA-256 of the key that publishes packages to this environment's package feed (README.md, Package feed:
## publishing, says how to generate both): the operator's key for scripts/feed-publish.sh. Optional: without it every
## publish with a key is refused. Each environment has its own key, so a sandbox release never reaches production's
## feed.
FEED_PUBLISH_KEY_SHA256=
## The GitHub logins, separated by commas, whose release runs may publish with a GitHub Actions OIDC token (README.md,
## Package feed: publishing). Optional: without it no OIDC token is accepted.
FEED_PUBLISH_ACTORS=

# Email (Resend) — production only (optional elsewhere: without RESEND_API_KEY, emails are logged, not sent)
RESEND_API_KEY=
# The no-reply sender, e.g. `Tenantry <noreply@tenantry.dev>`. Required wherever RESEND_API_KEY is set: no default.
EMAIL_FROM=
# Where customers' replies go (the sender is a no-reply address). Required in production.
EMAIL_REPLY_TO=
# Where operator alerts go (e.g. a licence that cannot be issued). Required in production; elsewhere alerts
# are only logged unless it is set.
ALERT_EMAIL=

# Reconcile cron — bearer secret for /api/reconcile. Vercel Cron auto-sends this as
# `Authorization: Bearer <CRON_SECRET>`; also required for manual POST triggers.
CRON_SECRET=

# Optional. Automated licence issuance: `manual` or `auto`; any other value stops the server. Only `auto` lets the
# webhook and reconcile paths issue licence keys. Unset or `manual`: purchases are recorded and the package feed follows
# them, but the operator issues licence keys by hand. Set `auto` only once the environment boundary has been verified.
PROVISIONING_MODE=
