# Copy this file to `.env.local` and fill in the values for the services you use.
# `.env.local` is gitignored — never commit real secrets.

# Site
NEXT_PUBLIC_SITE_URL= # e.g. http://localhost:3000

# Supabase
## Private
SUPABASE_SERVICE_ROLE_KEY=
## Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paddle
## Private
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_ENV= # `sandbox` or `production`
## Public
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
## Optional: JSON map of Paddle product id -> tier (overrides the default map)
PADDLE_PRODUCT_TIER_MAP=

# Licensing
## P-256 PKCS#8 private key (PEM) used to sign Pro licence tokens
LICENCE_SIGNING_PRIVATE_KEY=

# GitHub App (private package-feed provisioning)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_ORG=
GITHUB_TEAM=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Reconcile cron — bearer secret for /api/reconcile. Vercel Cron auto-sends this as
# `Authorization: Bearer <CRON_SECRET>`; also required for manual POST triggers.
CRON_SECRET=
